# Belt-and-braces excludes on top of the `files` allowlist in package.json.
# Nothing here is required by the CLI at runtime.

# Dev / CI / test artifacts
test/
scripts/
.github/
.planning/
.worktrees/
*.tgz
*.log

# Nested node_modules (root deps are installed by npm)
node_modules/
web/node_modules/
web/client/node_modules/
studio/node_modules/

# The pairing token must never leave a machine
web/.studio-token

# Source maps (shipped builds are minified assets, not debug source)
**/*.map
